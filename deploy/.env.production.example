# GlucoMind production configuration. On the server:
#   cp .env.production.example .env && chmod 600 .env
# then fill every <...>. This file is read by docker compose (interpolation) and passed to the api/worker containers.
# DATABASE_URL, NODE_ENV, APNS_PRIVATE_KEY_PATH and AI_EXPERIMENT_BUDGET_LEDGER_PATH are set in docker-compose.yml.

# --- Server ---
# Mellis release to run: an image tag from ghcr.io/<owner>/mellis (see .github/workflows/release-image.yml).
MELLIS_VERSION=<0.1.0>
# Only for a fork publishing its own image.
# MELLIS_IMAGE=ghcr.io/<owner>/mellis
# Public host name pointing at the VPS (A/AAAA record), e.g. glucomind.example.pl or name.duckdns.org.
DOMAIN=<api.your-domain>
# Long random password: openssl rand -hex 32
POSTGRES_PASSWORD=<random>
TZ=Europe/Warsaw
API_PORT=3000

# --- Auth (Cognito: one account per caregiver) ---
AUTH_MODE=cognito
COGNITO_USER_POOL_ID=<eu-central-1_xxxxxxxxx>
COGNITO_CLIENT_ID=<app client id>
COGNITO_TOKEN_USE=access
ALLOW_AUTH_DISABLED_IN_LOCAL=false
# Self-hosted instead: AUTH_MODE=device, SETUP_CODE=<installer's code>, PUBLIC_BASE_URL=<https address>; no COGNITO_*
# (docs/device-auth-api.md).

# --- Nightscout (the patient both caregivers share) ---
# Since migration 090 each patient's Nightscout is stored in the database with its token encrypted by this key
# (32 bytes: `openssl rand -hex 32`; keep a copy, the tokens cannot be read without it). The worker refuses to start
# without it. The NIGHTSCOUT_* values below seed the shared patient's source on the first start, then the stored one wins.
NIGHTSCOUT_TOKEN_ENCRYPTION_KEY=<64 hex characters>
NIGHTSCOUT_BASE_URL=<https://your-nightscout>
NIGHTSCOUT_API_TOKEN=<token or API secret>
NIGHTSCOUT_AUTH_MODE=API_SECRET_SHA1
# patients.id (UUID) of the shared patient; same value as in deploy/sql/link-caregiver.sql.
NIGHTSCOUT_PATIENT_ID=<patient uuid>
NIGHTSCOUT_SYNC_MAX_ENTRY_PAGES=24
NIGHTSCOUT_SYNC_ENABLED=true
# Closed beta (beta_allowlist + invitations); false opens sign-up to everyone.
BETA_ALLOWLIST_ENABLED=true

# --- AI (bounded by the durable ledger in deploy/data/ai) ---
# One AI key is enough, from either provider (checked at startup; infra/config/ai-capabilities.ts). OpenAI is recommended:
# one key covers answers, voice on the server and the full (hybrid) knowledge search.
#   - only ANTHROPIC_API_KEY: AI_PROVIDER=anthropic. Answers on Claude; knowledge search on full text (BM25, Claude
#     writes the query: ANTHROPIC_LIGHT_MODEL, else ANTHROPIC_MODEL); voice input transcribed on the phone (Apple Speech).
#   - only OPENAI_API_KEY: AI_PROVIDER=openai. Everything on OpenAI (hybrid knowledge search, voice on the server).
#   - both: AI_PROVIDER picks who answers; knowledge search embeddings and voice stay on OpenAI.
# AI_PROVIDER without its own key stops the worker. Every paid call of both providers goes through the same per-call
# limit (AI_EXPERIMENT_MAX_COST) and budget ledger (AI_EXPERIMENT_BUDGET_LEDGER_PATH).
AI_PROVIDER=openai
AI_BUDGETED_USAGE_SESSION=true
AI_ENABLE_TIME_RANGE_GLUCOSE_TOOL_CALLING=1
OPENAI_EVAL_CAPTURE_ENABLED=false
OPENAI_API_KEY=<sk-...>
OPENAI_TIMEOUT_MS=90000
# Whole AI execution (all calls of a tool loop); unset = 3 × OPENAI_TIMEOUT_MS.
# AI_TOOL_LOOP_TIMEOUT_MS=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_PRICING_INPUT_PER_1K_TOKENS=0.002
OPENAI_PRICING_CACHED_INPUT_PER_1K_TOKENS=0.0002
OPENAI_PRICING_OUTPUT_PER_1K_TOKENS=0.012
OPENAI_PRICING_REASONING_PER_1K_TOKENS=0
OPENAI_PRICING_CURRENCY=USD
OPENAI_PRICING_VERSION=openai.gpt-5.6-terra.2026-10
OPENAI_LIGHT_MODEL=gpt-5.6-luna
OPENAI_LIGHT_PRICING_INPUT_PER_1K_TOKENS=0.0002
OPENAI_LIGHT_PRICING_CACHED_INPUT_PER_1K_TOKENS=0.00002
OPENAI_LIGHT_PRICING_OUTPUT_PER_1K_TOKENS=0.0012
OPENAI_LIGHT_PRICING_REASONING_PER_1K_TOKENS=0
OPENAI_LIGHT_PRICING_CURRENCY=USD
OPENAI_LIGHT_PRICING_VERSION=openai.gpt-5.6-luna.2026-10
# Claude instead of OpenAI: AI_PROVIDER=anthropic (see ../.env.example for all ANTHROPIC_* keys).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=
ANTHROPIC_REFUSAL_FALLBACK=true
ANTHROPIC_PRICING_INPUT_PER_1K_TOKENS=0.004
ANTHROPIC_PRICING_CACHED_INPUT_PER_1K_TOKENS=0.0002
ANTHROPIC_PRICING_OUTPUT_PER_1K_TOKENS=0.02
ANTHROPIC_PRICING_REASONING_PER_1K_TOKENS=0
ANTHROPIC_PRICING_CURRENCY=USD
ANTHROPIC_PRICING_VERSION=anthropic.claude-opus-5-5.2026-10
# Hard limit per call; the total budget and call count live in the ledger file.
AI_EXPERIMENT_MAX_COST=0.25
AI_EXPERIMENT_COST_CURRENCY=USD
AI_EXPERIMENT_MAX_OUTPUT_TOKENS=4000
# Ledger file name inside deploy/data/ai (start a new file for each budget period, e.g. monthly).
AI_LEDGER_FILE=ai-usage-ledger-2026-10.json

# --- Push (APNs; key file at deploy/secrets/apns.p8) ---
PUSH_PROVIDER=apns
APNS_TEAM_ID=<team id>
APNS_KEY_ID=<key id>
APNS_BUNDLE_ID=pl.glucomind.ios
# false for TestFlight/App Store builds, true only for apps installed from Xcode.
APNS_USE_SANDBOX=false
APNS_TIMEOUT_MS=10000

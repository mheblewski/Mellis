# Mellis server settings: what scripts/install-server.sh writes to /opt/mellis/.env (chmod 600, keys live only here).
# The installer and `mellis → Zmień ustawienia` fill and change it; this file only shows the keys. Writing it by hand
# (a developer's own image, deploy/README.md):
#   cp .env.production.example .env && chmod 600 .env
# then fill every <...>. Read by docker compose (interpolation) and passed to the api/worker containers.
# DATABASE_URL, NODE_ENV, APNS_PRIVATE_KEY_PATH and AI_EXPERIMENT_BUDGET_LEDGER_PATH are set in docker-compose.yml.

# --- Server ---
# Mellis release to run: an image tag from ghcr.io/mheblewski/mellis (X.Y.Z).
MELLIS_VERSION=<X.Y.Z>
# Only for a fork publishing its own image.
# MELLIS_IMAGE=ghcr.io/<owner>/mellis
MELLIS_SERVER_ID=<openssl rand -hex 8>
TZ=Europe/Warsaw
# Long random password: openssl rand -hex 32
POSTGRES_PASSWORD=<random>
API_PORT=3000
# Where the API is published on the host: 127.0.0.1:<port> behind Caddy or another local proxy.
API_PUBLISH=127.0.0.1:4100

# --- Address ---
# caddy: Caddy gets a certificate for DOMAIN; tunnel: Cloudflare Tunnel (CLOUDFLARE_TUNNEL_TOKEN); empty: your own proxy.
COMPOSE_PROFILES=caddy
DOMAIN=<mellis.your-domain>
# The https address phones use. Required: pairing QR codes and invitations are built only from it.
PUBLIC_BASE_URL=https://<mellis.your-domain>
CLOUDFLARE_TUNNEL_TOKEN=

# --- Phones (pairing by QR code, docs/device-auth-api.md) ---
AUTH_MODE=device
# Opens the first setup until the owner's phone pairs (at least 16 characters).
SETUP_CODE=<setup code>

# --- Nightscout ---
# Each patient's Nightscout (address and read-only token) is added in the app and stored in the database, the token
# encrypted with this key (32 bytes: openssl rand -hex 32). Keep a copy: without it the tokens cannot be read.
NIGHTSCOUT_TOKEN_ENCRYPTION_KEY=<64 hex characters>
NIGHTSCOUT_SYNC_ENABLED=true
NIGHTSCOUT_SYNC_MAX_ENTRY_PAGES=24

# --- Features (each one is still switched per patient, person or phone in the app) ---
REMOTE_COMMANDS_ENABLED=true
AI_ENABLE_MEAL_ACTIONS=1
AI_ENABLE_BOLUS_PROPOSALS=1
RESCUE_CARB_ALERTS_ENABLED=1
AI_ENABLE_TIME_RANGE_GLUCOSE_TOOL_CALLING=1
# 1 once the shipped knowledge base is indexed (the installer does it).
AI_ENABLE_KNOWLEDGE_SEARCH=0
# Forecast corrections: unset = the loop's own forecast (Trio/Loop) as it is, for everyone; the bolus chart draws only it.
# fitted-v1 adds Mellis' own dose line, fitted on one patient's data (Trio): dopasowane do jednego pacjenta, włączaj tylko u niego.
# FORECAST_CALIBRATION=

# --- AI (one key from either provider; infra/config/ai-capabilities.ts) ---
#   - only ANTHROPIC_API_KEY: AI_PROVIDER=anthropic. Answers on Claude; knowledge search on full text; voice input
#     transcribed on the phone (Apple Speech).
#   - only OPENAI_API_KEY: AI_PROVIDER=openai. Everything on OpenAI (hybrid knowledge search, voice on the server).
#   - both: AI_PROVIDER picks who answers; knowledge search embeddings and voice stay on OpenAI.
# fake: canned answers, nothing paid (until a key is checked). Every paid call goes through the per-call limit
# (AI_EXPERIMENT_MAX_COST) and the budget ledger in /opt/mellis/data/ai.
AI_PROVIDER=fake
AI_BUDGETED_USAGE_SESSION=true
AI_LEDGER_FILE=ai-usage-ledger.json
AI_MONTHLY_LIMIT_USD=15
AI_EXPERIMENT_MAX_COST=0.25
AI_EXPERIMENT_COST_CURRENCY=USD
AI_EXPERIMENT_MAX_OUTPUT_TOKENS=4000
OPENAI_EVAL_CAPTURE_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Models and prices: the installer writes the current ones (scripts/install-server.sh, write_ai_env), e.g.
# OPENAI_MODEL, OPENAI_PRICING_*, OPENAI_LIGHT_MODEL, OPENAI_LIGHT_PRICING_*, ANTHROPIC_MODEL, ANTHROPIC_PRICING_*.
# The worker refuses to start a paid provider without its prices.
VOICE_TRANSCRIPTION_ENABLED=0

# --- Push (APNs; the .p8 key at /opt/mellis/secrets/apns.p8) ---
# fake until the key is added.
PUSH_PROVIDER=fake
APNS_TEAM_ID=<team id>
APNS_KEY_ID=<key id>
# scripts/install-app.sh builds the app as pl.mellis.<Team ID>.
APNS_BUNDLE_ID=pl.mellis.<team id>
# Apps built in Xcode (install-app.sh) use the APNs sandbox.
APNS_USE_SANDBOX=true
APNS_TIMEOUT_MS=10000

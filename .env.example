# Mellis: local development settings (npm run dev:api / dev:worker). A server is set up by scripts/install-server.sh,
# not from this file (deploy/.env.production.example shows what it writes).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gluco_mind
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gluco_mind_test
RUN_POSTGRES_INTEGRATION=0
API_PORT=3000
# Optional: unset listens on every interface (needed for a physical iPhone); 127.0.0.1 keeps the API local-only.
# API_HOST=127.0.0.1

# Each patient's Nightscout is stored in the database (sources, token encrypted with this key: 32 bytes, e.g.
# `openssl rand -hex 32`). Required while the sync is on; losing it means re-entering every patient's token.
NIGHTSCOUT_TOKEN_ENCRYPTION_KEY=replace-me
# The four NIGHTSCOUT_* below only seed one patient's stored source once (all or none); later changes live in the database.
NIGHTSCOUT_BASE_URL=https://nightscout.example.com
NIGHTSCOUT_API_TOKEN=replace-me
NIGHTSCOUT_AUTH_MODE=BEARER
NIGHTSCOUT_PATIENT_ID=replace-me
NIGHTSCOUT_SYNC_MAX_ENTRY_PAGES=24
# Each sync re-reads this many minutes behind its cursors for entries/treatments uploaded late (0 = off).
NIGHTSCOUT_SYNC_LOOKBACK_MINUTES=360
# A new Nightscout source imports this many days of treatments and CGM (device statuses: the second value) in the
# background after its first sync; also fills a gap longer than a day (a restored backup).
NIGHTSCOUT_INITIAL_HISTORY_DAYS=30
NIGHTSCOUT_INITIAL_DEVICESTATUS_DAYS=7
# false: the worker registers no Nightscout source, schedules no nightscout.sync and claims none (local testing).
NIGHTSCOUT_SYNC_ENABLED=true
# fake: canned answers, no paid calls (development). One key from either provider is enough (infra/config/ai-capabilities.ts);
# OpenAI is recommended (one key covers answers, voice on the server and the hybrid knowledge search); Anthropic-only
# answers on Claude, searches knowledge on full text and leaves voice to the phone (Apple Speech).
AI_PROVIDER=fake
# Enable evidence tool loop for time-range analysis only when explicitly needed.
AI_ENABLE_TIME_RANGE_GLUCOSE_TOOL_CALLING=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=15000
# Whole AI execution (all calls of a tool loop); unset = 3 × OPENAI_TIMEOUT_MS.
# AI_TOOL_LOOP_TIMEOUT_MS=
# Explicit prompt-cache breakpoint after the system message (gpt-5.6+): new questions reuse the cached system prompt.
OPENAI_PROMPT_CACHE_BREAKPOINTS=0
# Tool rounds chained on an earlier response skip the free token-count request (bound from the previous usage, never
# lower than the count); unset = on, 0 = count every call.
# OPENAI_CHAINED_INPUT_BOUND=
# Flex tier (same model, half price, slower; a 429 or a flex timeout retries once on the standard tier). Unset = standard.
OPENAI_SERVICE_TIER=
OPENAI_FLEX_TIMEOUT_MS=
# Price factor of flex calls (OpenAI: 0.5 for gpt-5.6); unset = priced as standard.
OPENAI_FLEX_PRICE_MULTIPLIER=
# Cache write price (gpt-5.6: 1.25x input); unset = 1.25x the input price. Same for OPENAI_LIGHT_PRICING_.
OPENAI_PRICING_CACHE_WRITE_PER_1K_TOKENS=
# Content experiments (off unless set; enable only after an A/B): prefetch of what analyses usually fetch, compact
# evidence format (local times, record lists as columns), number of follow-up candidates (3-5, default 5).
AI_TIME_RANGE_PREFETCH=0
AI_MODEL_FACING_COMPACT_FORMAT=0
AI_FOLLOW_UP_CANDIDATE_COUNT=
# Required when AI_PROVIDER=openai to persist KNOWN ai_cost values
OPENAI_PRICING_INPUT_PER_1K_TOKENS=
OPENAI_PRICING_OUTPUT_PER_1K_TOKENS=
OPENAI_PRICING_CACHED_INPUT_PER_1K_TOKENS=
OPENAI_PRICING_REASONING_PER_1K_TOKENS=
OPENAI_PRICING_CURRENCY=
OPENAI_PRICING_VERSION=
# Optional light model for direct replies and plain data lookups (analyses always use OPENAI_MODEL).
# When set, all OPENAI_LIGHT_PRICING_* keys are required; both models share the cost guard and budget ledger.
OPENAI_LIGHT_MODEL=
OPENAI_LIGHT_PRICING_INPUT_PER_1K_TOKENS=
OPENAI_LIGHT_PRICING_CACHED_INPUT_PER_1K_TOKENS=
OPENAI_LIGHT_PRICING_OUTPUT_PER_1K_TOKENS=
OPENAI_LIGHT_PRICING_REASONING_PER_1K_TOKENS=
OPENAI_LIGHT_PRICING_CURRENCY=
OPENAI_LIGHT_PRICING_VERSION=
# Claude (AI_PROVIDER=anthropic): the same requests, cost guard and ledger. With OPENAI_API_KEY too, embeddings and voice
# transcription stay on it; with the Claude key alone, knowledge search is full text (BM25) and voice is transcribed on
# the phone (see deploy/.env.production.example). Pricing keys follow the OPENAI_PRICING_* rules (light tier: ANTHROPIC_LIGHT_MODEL + ANTHROPIC_LIGHT_PRICING_*).
# claude-opus-5-5 per 1k tokens: input 0.004, cache hit 0.0002, output 0.02 (thinking is output; reasoning price 0).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max; unset = the model's default.
ANTHROPIC_EFFORT=
ANTHROPIC_REFUSAL_FALLBACK=true
ANTHROPIC_PRICING_INPUT_PER_1K_TOKENS=
ANTHROPIC_PRICING_CACHED_INPUT_PER_1K_TOKENS=
ANTHROPIC_PRICING_OUTPUT_PER_1K_TOKENS=
ANTHROPIC_PRICING_REASONING_PER_1K_TOKENS=
ANTHROPIC_PRICING_CURRENCY=
ANTHROPIC_PRICING_VERSION=
ANTHROPIC_LIGHT_MODEL=
# Required when AI_PROVIDER=openai or anthropic (no defaults; the worker refuses to start without them).
# Paid calls run in a budgeted usage session (AI_BUDGETED_USAGE_SESSION=true). Cost limit per call in
# AI_EXPERIMENT_COST_CURRENCY, which must equal OPENAI_PRICING_CURRENCY; a call whose worst-case cost exceeds it is
# refused before sending.
AI_BUDGETED_USAGE_SESSION=
AI_EXPERIMENT_MAX_COST=
AI_EXPERIMENT_COST_CURRENCY=
AI_EXPERIMENT_MAX_OUTPUT_TOKENS=
# Durable experiment budget (total budget + max calls across all jobs/processes), absolute path outside every Git
# working tree. Created only by scripts/evaluation/init-ai-experiment-budget-ledger.ts; never created implicitly.
AI_EXPERIMENT_BUDGET_LEDGER_PATH=

PUSH_PROVIDER=fake
APPLE_TEAM_ID=
# The app's bundle id: scripts/install-app.sh builds pl.mellis.<Team ID>.
IOS_BUNDLE_ID=pl.mellis.<TEAMID>
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_BUNDLE_ID=pl.mellis.<TEAMID>
APNS_USE_SANDBOX=true
APNS_TIMEOUT_MS=10000

API_BASE_URL=http://192.168.1.10:3000
GLUCOMIND_API_BASE_URL=http://192.168.1.10:3000
NODE_ENV=development
# Phones pair with the server by QR code and sign in with a key in the Secure Enclave (docs/device-auth-api.md).
# SETUP_CODE (at least 16 characters, `node dist/apps/api/src/cli/mellis-admin.js generate-code`) opens the setup until
# the first owner's phone pairs. PUBLIC_BASE_URL is the address put into pairing QR codes and invitation links: without
# it the server refuses to create them (it never builds them from the request's Host). A Nightscout on the same Docker
# network: list its name in NIGHTSCOUT_ALLOWED_HOSTS (that list then is the only hosts allowed).
AUTH_MODE=device
SETUP_CODE=
PUBLIC_BASE_URL=http://192.168.1.10:3000
# NIGHTSCOUT_ALLOWED_HOSTS=
# Forecast corrections (forecast-calibration.ts): unset = the loop's own forecast (Trio/Loop) as it is; the bolus chart
# draws only it (no line with the typed dose). fitted-v1 adds Mellis' own dose line and coefficients fitted on one patient's data: dopasowane do jednego pacjenta, włączaj tylko u niego.
# FORECAST_CALIBRATION=
# Release shown in GET /v1/app-config (server.version / server.revision); the released image sets both, a server built
# by hand reads REVISION next to the app or reports null.
# MELLIS_VERSION=
# MELLIS_REVISION=
GLUCOMIND_BOOTSTRAP_CONVERSATION_ID=
